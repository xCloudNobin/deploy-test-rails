<% content_for(:title) { @task.title } %>

<h1><%= @task.title %></h1>

<p class="meta">
  <span class="badge badge-<%= @task.status %>"><%= @task.status.humanize %></span>
  <span class="badge badge-<%= @task.priority %>"><%= @task.priority.humanize %></span>
  <span>Owner: <%= @task.owner.presence || "—" %></span>
  <span>Due: <%= @task.due_on || "—" %></span>
</p>

<% if @task.description.present? %>
  <div class="description"><%= simple_format(@task.description) %></div>
<% else %>
  <p class="hint">No description.</p>
<% end %>

<%= link_to "Edit", edit_task_path(@task), class: "button" %>
<%= link_to "Back", tasks_path, class: "link-button" %>