<% content_for(:title) { "Tasks" } %>

<h1>Tasks</h1>

<%= form_with(url: tasks_path, method: :get, class: "filters", scope: :filter) do |form| %>
  <%= form.text_field :q, value: @q, placeholder: "Search title, description or owner…" %>
  <%= form.select :status, [["Any status", ""]] + Task.statuses.map { |k, _| [k.humanize, k] }, selected: @status %>
  <%= form.select :priority, [["Any priority", ""]] + Task.priorities.map { |k, _| [k.humanize, k] }, selected: @priority %>
  <label class="check">
    <%= form.check_box :overdue, checked: @overdue %>
    Overdue only
  </label>
  <%= form.submit "Filter" %>
  <%= link_to "Clear", tasks_path, class: "link-button" %>
<% end %>

<table class="tasks">
  <thead>
    <tr>
      <th>Title</th>
      <th>Owner</th>
      <th>Status</th>
      <th>Priority</th>
      <th>Due</th>
      <th colspan="2"></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.title, task_path(task) %></td>
        <td><%= task.owner.presence || "—" %></td>
        <td><span class="badge badge-<%= task.status %>"><%= task.status.humanize %></span></td>
        <td><span class="badge badge-<%= task.priority %>"><%= task.priority.humanize %></span></td>
        <td><%= task.due_on || "—" %></td>
        <td><%= link_to "Edit", edit_task_path(task) %></td>
        <td><%= button_to "Delete", task_path(task), method: :delete,
                          data: { turbo_confirm: "Delete this task?" } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @tasks.empty? %>
  <p class="hint">No tasks match.</p>
<% end %>

<%= link_to "New task", new_task_path, class: "button" %>