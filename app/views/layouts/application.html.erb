<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Taskboard" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <%= link_to "Taskboard", root_path, class: "brand" %>
        <nav>
          <% if logged_in? %>
            <%= link_to "Tasks", tasks_path %>
            <%= link_to "New task", new_task_path %>
            <span class="user"><%= current_user.email %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "link-button" %>
          <% else %>
            <%= link_to "Sign in", new_session_path %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice.present? %>
      <p class="flash flash-notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="flash flash-alert"><%= alert %></p>
    <% end %>

    <main class="container">
      <%= yield %>
    </main>
  </body>
</html>